{
  "$description": "KaamSathi semantic design tokens — single source for web (CSS variables / Tailwind theme) and Flutter (ThemeData + ThemeExtension). Derived from docs/design-tokens.json (brand v2/v3). Every text/background pair below is checked to WCAG 2.2 AA (4.5:1 body text, 3:1 large text and UI indicators). Raw brand hues that fail as text are kept for fills/icons only and paired with an AA-safe *.text variant of the same hue. Do not hard-code colours in feature code.",
  "version": "2.0.0",
  "font": {
    "latin": "Inter",
    "devanagari": "Noto Sans Devanagari",
    "weights": [400, 500, 600, 700, 800],
    "minBodyPx": 14
  },
  "color": {
    "light": {
      "action.primary": "#2563EB",
      "action.primary.hover": "#1D4ED8",
      "action.primary.fg": "#FFFFFF",
      "action.primary.subtle": "#EFF6FF",
      "action.primary.subtle.fg": "#1D4ED8",
      "brand.indigo": "#4F46E5",
      "brand.indigo.subtle": "#EEF2FF",
      "accent.coral": "#FF6B6B",
      "accent.coral.text": "#C2410C",
      "accent.coral.subtle": "#FFF1F1",
      "accent.yellow": "#FBBF24",
      "accent.yellow.subtle": "#FEF9E7",
      "accent.teal": "#14B8A6",
      "accent.teal.text": "#0F766E",
      "accent.teal.subtle": "#F0FDFA",
      "accent.onFill": "#0F172A",
      "text.primary": "#0F172A",
      "text.secondary": "#334155",
      "text.muted": "#5A6679",
      "text.inverse": "#FFFFFF",
      "surface.canvas": "#F8FAFC",
      "surface.default": "#FFFFFF",
      "surface.muted": "#F1F5F9",
      "border.default": "#E2E8F0",
      "border.strong": "#CBD5E1",
      "focus.ring": "#2563EB",
      "status.success": "#16A34A",
      "status.success.text": "#15803D",
      "status.success.soft": "#DCFCE7",
      "status.warning": "#D97706",
      "status.warning.text": "#A14A07",
      "status.warning.soft": "#FEF3C7",
      "status.error": "#DC2626",
      "status.error.text": "#B91C1C",
      "status.error.soft": "#FEE2E2",
      "status.info": "#0284C7",
      "status.info.text": "#0369A1",
      "status.info.soft": "#E0F2FE",
      "status.verified": "#0F766E",
      "status.verified.text": "#0F766E",
      "status.verified.soft": "#CCFBF1"
    },
    "dark": {
      "$note": "Not a launch blocker (brand v2 §24). Slate 950/900 surfaces, desaturated accents; agents must re-verify AA for every pair they add.",
      "action.primary": "#3B82F6",
      "action.primary.hover": "#60A5FA",
      "action.primary.fg": "#0B1220",
      "action.primary.subtle": "#172554",
      "action.primary.subtle.fg": "#BFDBFE",
      "text.primary": "#F1F5F9",
      "text.secondary": "#CBD5E1",
      "text.muted": "#94A3B8",
      "surface.canvas": "#020617",
      "surface.default": "#0F172A",
      "surface.muted": "#1E293B",
      "border.default": "#1E293B",
      "border.strong": "#334155",
      "status.success.text": "#4ADE80",
      "status.warning.text": "#FBBF24",
      "status.error.text": "#F87171",
      "status.info.text": "#38BDF8",
      "status.verified.text": "#2DD4BF"
    }
  },
  "usageRules": [
    "Text on status soft backgrounds uses status.*.text, never the raw status colour.",
    "Coral, yellow and teal are accents: fills, illustrations, highlights. Text on them is accent.onFill (#0F172A), never white.",
    "70/20/10: neutral surfaces / primary + tints / accents. Max 3 accents per screen, max 2 vibrant accents per marketing section.",
    "Gradients only: marketing hero/campaign strips, onboarding, milestone celebrations. Never behind tables, forms or long text.",
    "Status is never colour-only: pair with icon + label."
  ],
  "gradient": {
    "hero": "linear-gradient(135deg, #2563EB 0%, #4F46E5 55%, #7C3AED 100%)",
    "joy": "linear-gradient(135deg, #FF6B6B 0%, #F59E0B 100%)",
    "skill": "linear-gradient(135deg, #14B8A6 0%, #2563EB 100%)"
  },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 18, "xl": 24, "pill": 999, "control": 12, "card": 16, "sheet": 22, "denseCard": 10 },
  "space": [4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96],
  "shadow": {
    "card": "0 1px 2px rgba(15,23,42,.06), 0 6px 18px rgba(15,23,42,.06)",
    "floating": "0 12px 32px rgba(15,23,42,.12)"
  },
  "type": {
    "web": { "displayXl": [56, 64], "display": [48, 56], "h1": [36, 44], "h2": [30, 38], "h3": [24, 32], "h4": [20, 28], "bodyL": [18, 28], "body": [16, 24], "bodyS": [14, 20], "caption": [12, 16] },
    "mobile": { "h1": [30, 38], "h2": [24, 32], "h3": [20, 28], "body": [16, 24], "caption": [12, 16] },
    "devanagariLineHeightBoost": 1.1
  },
  "motion": {
    "control": 150,
    "base": 200,
    "slow": 280,
    "content": 360,
    "easing": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
    "respectReducedMotion": true
  },
  "touchTargetMin": 44
}
