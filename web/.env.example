# Server-only: backend base URL used by the BFF proxy and auth route handlers.
API_BASE_URL=http://localhost:8000/api/v1
# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" behind HTTPS so auth cookies get the Secure flag (defaults to NODE_ENV=production)
# COOKIE_SECURE=true
