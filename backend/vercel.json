{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,media/**,**/__pycache__/**,requirements-dev.txt,pytest.ini,ruff.toml,Dockerfile,entrypoint.sh,gunicorn.conf.py}"
    }
  },
  "crons": [{ "path": "/api/v1/internal/cron", "schedule": "15 0 * * *" }]
}
