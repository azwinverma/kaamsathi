msgstr "कागजात अपलोड गरिएको छैन; प्रमाणित गर्न मिल्दैन।"

msgctxt "mobility"
msgid "Only recruitment agencies have licence compliance."
msgstr "इजाजतपत्र अनुपालन म्यानपावर कम्पनीका लागि मात्र हो।"

msgctxt "mobility"
msgid "Record the agency's DoFE licence number first."
msgstr "पहिले एजेन्सीको वैदेशिक रोजगार विभागको इजाजतपत्र नम्बर राख्नुहोस्।"

msgctxt "mobility"
msgid "A verified licence must be valid today or later."
msgstr "प्रमाणित इजाजतपत्रको म्याद आज वा त्यसपछिसम्म हुनुपर्छ।"

msgctxt "mobility"
msgid "Must be between 1 and %(max)s days."
msgstr "१ देखि %(max)s दिनसम्म हुनुपर्छ।"

msgctxt "mobility"
msgid "The document group cannot be changed."
msgstr "कागजातको समूह परिवर्तन गर्न मिल्दैन।"

msgctxt "mobility"
msgid "This kind does not belong to the chosen group."
msgstr "यो प्रकार रोजिएको समूहमा पर्दैन।"

msgctxt "mobility"
msgid "Enter the document number."
msgstr "कागजातको नम्बर लेख्नुहोस्।"

msgctxt "mobility"
msgid "Enter who issued it."
msgstr "कसले जारी गरेको हो लेख्नुहोस्।"

msgctxt "mobility"
msgid "Upload a photo or PDF of the document."
msgstr "कागजातको फोटो वा PDF अपलोड गर्नुहोस्।"

msgctxt "mobility"
msgid "Expiry date cannot be before the issue date."
msgstr "म्याद सकिने मिति जारी मितिभन्दा अघि हुन सक्दैन।"

msgctxt "mobility"
msgid "Issue date cannot be in the future."
msgstr "जारी मिति भविष्यको हुन सक्दैन।"

msgctxt "mobility"
msgid "Tell the worker why it was rejected."
msgstr "किन अस्वीकृत भयो, कामदारलाई कारण लेख्नुहोस्।"

msgctxt "mobility"
msgid "Record why the agency is suspended."
msgstr "एजेन्सी किन निलम्बन गरियो, कारण लेख्नुहोस्।"

msgctxt "mobility"
msgid "A verified document cannot be edited. Add the new document instead."
