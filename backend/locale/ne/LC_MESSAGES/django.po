msgctxt "mobility"
msgid "Agency not found."
msgstr "एजेन्सी फेला परेन।"

msgctxt "mobility"
msgid "Read the verification status of your foreign-employment documents"
msgstr "तपाईंका वैदेशिक रोजगारी कागजातको प्रमाणीकरण स्थिति हेर्ने"

msgctxt "mobility"
msgid "Not verified"
msgstr "प्रमाणित नभएको"

msgctxt "mobility"
msgid "Licence verified"
msgstr "इजाजतपत्र प्रमाणित"

msgctxt "mobility"
msgid "Suspended"
msgstr "निलम्बित"

msgctxt "mobility"
msgid ""
"Documents can only be shared with a recruitment agency whose DoFE licence "
"KaamSathi has verified and which has not expired."
msgstr ""
"कागजात कामसाथीले वैदेशिक रोजगार विभागको इजाजतपत्र प्रमाणित गरेको र म्याद "
"ननाघेको म्यानपावर कम्पनीलाई मात्र पठाउन सकिन्छ।"

