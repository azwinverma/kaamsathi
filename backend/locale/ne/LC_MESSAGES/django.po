msgid "Some fields are invalid."
msgstr "केही विवरण मिलेनन्।"

msgid "Please log in to continue."
msgstr "अगाडि बढ्न लगइन गर्नुहोस्।"

msgid "You do not have permission to do this."
msgstr "तपाईंलाई यो काम गर्ने अनुमति छैन।"

msgid "You do not have access to this organization."
msgstr "तपाईंलाई यो संस्थामा पहुँच छैन।"

msgid "Not found."
msgstr "भेटिएन।"

msgid "The code is incorrect."
msgstr "कोड मिलेन।"

msgid "The code has expired. Please request a new one."
msgstr "कोडको समय सकियो। नयाँ कोड माग्नुहोस्।"

msgid "Too many code requests. Please try again later."
msgstr "धेरै पटक कोड मागियो। केही समयपछि फेरि प्रयास गर्नुहोस्।"

msgid "Wage is below the government minimum wage."
msgstr "तलब सरकारले तोकेको न्यूनतम पारिश्रमिकभन्दा कम छ।"

msgid "This action is not allowed in the current state."
msgstr "हालको अवस्थामा यो काम गर्न मिल्दैन।"

msgid "You are outside the work site area."
msgstr "तपाईं कार्यस्थलको क्षेत्रभन्दा बाहिर हुनुहुन्छ।"

msgid "This already exists."
msgstr "यो पहिले नै छ।"

msgid "Too many requests. Please slow down."
msgstr "धेरै अनुरोध भयो। केही बेर पर्खनुहोस्।"

msgid "Something went wrong. Please try again."
msgstr "केही गडबड भयो। फेरि प्रयास गर्नुहोस्।"

#, python-format
msgid "Wage must be at least %(amount)s (minimum wage)."
msgstr "तलब कम्तीमा %(amount)s हुनुपर्छ (न्यूनतम पारिश्रमिक)।"

#, python-format
msgid "Cannot move from %(from)s to %(to)s."
msgstr "%(from)s बाट %(to)s मा सार्न मिल्दैन।"

msgid "Employment details are required to join."
msgstr "काममा लगाउन रोजगारीको विवरण चाहिन्छ।"

msgid "This field is required for monthly wage."
msgstr "मासिक तलबका लागि यो विवरण अनिवार्य छ।"

#, python-format
msgid "Basic + DA must be at least %(amount)s per month (minimum wage)."
msgstr "आधारभूत तलब + महँगी भत्ता मासिक कम्तीमा %(amount)s हुनुपर्छ (न्यूनतम पारिश्रमिक)।"

msgid "This field is required for daily wage."
msgstr "दैनिक ज्यालाका लागि यो विवरण अनिवार्य छ।"

#, python-format
msgid "Daily wage must be at least %(amount)s (minimum wage)."
msgstr "दैनिक ज्याला कम्तीमा %(amount)s हुनुपर्छ (न्यूनतम पारिश्रमिक)।"

msgid "Must be monthly or daily."
msgstr "मासिक वा दैनिक मध्ये एक हुनुपर्छ।"

msgid "Enter a valid 10-digit mobile number."
msgstr "१० अङ्कको सही मोबाइल नम्बर लेख्नुहोस्।"

msgid "This field is required."
msgstr "यो विवरण अनिवार्य छ।"

msgid "This worker already has an active employment in your organization."
msgstr "यो कामदार तपाईंको संस्थामा पहिले नै कार्यरत हुनुहुन्छ।"

msgid "Payroll for this month is approved; attendance is locked."
msgstr "यो महिनाको तलबी स्वीकृत भइसकेको छ; हाजिरी परिवर्तन गर्न मिल्दैन।"

msgid "The worker is not employed on this date."
msgstr "यो मितिमा कामदार कार्यरत हुनुहुन्नथ्यो।"

msgid "client_uuid already used for another record."
msgstr "यो client_uuid अर्को अभिलेखमा प्रयोग भइसकेको छ।"

msgid "End date cannot be before start date."
msgstr "अन्त्य मिति सुरु मितिभन्दा अघि हुन सक्दैन।"

msgid "English"
msgstr "अङ्ग्रेजी"

msgid "Nepali"
msgstr "नेपाली"
