msgstr "केही विवरण मिलेनन्।"

msgid "Please log in to continue."
msgstr "अगाडि बढ्न लगइन गर्नुहोस्।"

msgid "You do not have permission to do this."
msgstr "तपाईंलाई यो काम गर्ने अनुमति छैन।"

