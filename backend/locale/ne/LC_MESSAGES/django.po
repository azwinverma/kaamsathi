# --- compliance / payouts / scheduling ---
msgid "SSF filing can be prepared only for approved or paid payroll runs."
msgstr "स्वीकृत वा भुक्तानी भएको तलबी मात्र सामाजिक सुरक्षा कोष विवरण तयार गर्न सकिन्छ।"

msgid "This SSF filing is already submitted."
msgstr "यो सामाजिक सुरक्षा कोष विवरण पहिल्यै बुझाइसकिएको छ।"

msgid "An SSF filing cannot move back to an earlier status."
msgstr "सामाजिक सुरक्षा कोष विवरणलाई अघिल्लो अवस्थामा फर्काउन मिल्दैन।"

msgid "Your organization is registered with SSF."
msgstr "तपाईंको संस्था सामाजिक सुरक्षा कोषमा दर्ता छ।"

msgid "Add your SSF employer registration number in organization settings."
msgstr "संस्थाको सेटिङमा सामाजिक सुरक्षा कोषको रोजगारदाता दर्ता नम्बर थप्नुहोस्।"

msgid "Every SSF-enrolled worker has an SSF ID."
msgstr "सामाजिक सुरक्षा कोषमा सूचीकृत सबै कामदारको परिचय नम्बर छ।"

#, python-format
