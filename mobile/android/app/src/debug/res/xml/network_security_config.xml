<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only (overrides src/main/res/xml/network_security_config.xml).
     Cleartext HTTP is allowed so the app can reach the local Django dev server:
     10.0.2.2 (emulator -> host), localhost, and LAN IPs when running on a
     physical phone (network-security-config cannot express IP ranges, so the
     debug base-config permits cleartext). Release builds never see this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
