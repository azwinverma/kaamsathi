# Copied to .env by `make env`. Read by backend settings (backend/.env takes precedence).
# Local dev runs Postgres/Redis from docker compose on non-default ports.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DATABASE_URL=postgres://kaamsathi:kaamsathi@localhost:5433/kaamsathi
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_TASK_ALWAYS_EAGER=true

# Dev only: this OTP always works and is returned by /auth/otp/request. Never set in production.
OTP_DEV_CODE=123456

# SMS: console | sparrow | aakash
SMS_BACKEND=console
SPARROW_SMS_TOKEN=
AAKASH_SMS_TOKEN=

# Optional S3-compatible media storage
AWS_STORAGE_BUCKET_NAME=
SENTRY_DSN=
