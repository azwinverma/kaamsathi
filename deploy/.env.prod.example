# KaamSathi production environment — copy to deploy/.env.prod (gitignored) and fill every value.
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# Generate secrets with:  openssl rand -hex 32   (hex avoids URL-escaping problems in DSNs)
# Staging: copy to deploy/.env.staging, use different secrets/domains, SENTRY_ENVIRONMENT=staging.

# --- Project / release ---------------------------------------------------------
PROJECT=kaamsathi                     # compose project name (kaamsathi-staging for staging)
RELEASE=                              # git SHA or tag; `make deploy-up` fills it from git
# BACKEND_IMAGE=registry.example.com/kaamsathi-backend:<tag>   # optional: pull prebuilt images
# WEB_IMAGE=registry.example.com/kaamsathi-web:<tag>

# --- Domains / TLS (DNS A/AAAA records must point at this host before first start) ---
DOMAIN=kaamsathi.com                  # web: marketing, employer portal /app, ops console /ops
API_DOMAIN=api.kaamsathi.com          # API for the mobile app + signed file links + admin
ACME_EMAIL=ops@kaamsathi.com          # Let's Encrypt expiry notices

# --- Django ---------------------------------------------------------------------
DJANGO_SECRET_KEY=                    # REQUIRED, 64+ random chars. Signs sessions and file links.
DJANGO_SECRET_KEY_FALLBACKS=          # comma-separated OLD keys during rotation (see docs/RUNBOOK.md)
JWT_SIGNING_KEY=                      # REQUIRED, separate from SECRET_KEY; rotating logs everyone out
# Field encryption for citizenship/NID/passport/PAN/bank numbers (apps/core/crypto.py). REQUIRED.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=                # newest first, comma-separated; keep old keys until rotate_field_keys ran
FIELD_HASH_KEY=                       # REQUIRED, 64+ random chars; never rotate casually (re-index needed)
DJANGO_ADMIN_URL=ops-admin-change-me/ # non-default admin path (staff only)
BFF_PROXY_SECRET=                     # REQUIRED (hex); web → API: relays each user's IP for OTP throttles/audit
# Defaults derived from the domains above; override only if you need more hosts/origins:
# DJANGO_ALLOWED_HOSTS=api.kaamsathi.com,backend,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://kaamsathi.com
# CSRF_TRUSTED_ORIGINS=https://api.kaamsathi.com,https://kaamsathi.com
LOG_LEVEL=INFO

# --- PostgreSQL / Redis -----------------------------------------------------------
POSTGRES_DB=kaamsathi
POSTGRES_USER=kaamsathi
POSTGRES_PASSWORD=                    # REQUIRED (hex)
REDIS_PASSWORD=                       # REQUIRED (hex)

# --- Capacity ---------------------------------------------------------------------
GUNICORN_WORKERS=3                    # ≈ 2×vCPU+1; each ~150 MB
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2

# --- SMS (OTP login depends on this!) — console | sparrow | aakash -------------------
SMS_BACKEND=sparrow
SMS_SENDER_ID=KaamSathi
SPARROW_SMS_TOKEN=                    # Sparrow SMS API token (primary)
SPARROW_SMS_FROM=InfoSMS              # approved sender identity
AAKASH_SMS_TOKEN=                     # Aakash SMS token (failover: set SMS_BACKEND=aakash)

# --- Push notifications (FCM HTTP v1) — optional; push is skipped when either is empty ---
FCM_PROJECT_ID=                       # Firebase project id
FCM_SERVICE_ACCOUNT_JSON=             # service-account key: inline JSON or path to the mounted .json file

# --- Transactional email (payslips, account notices; no marketing) --------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=                           # e.g. smtp.sendgrid.net / email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KaamSathi <no-reply@kaamsathi.com.np>

# --- Media storage ----------------------------------------------------------------
# Empty bucket → local volume `media` (backed up nightly by the backup service).
# With S3: the bucket MUST block all public access; files are served via signed links only.
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=              # optional separate bucket for exports (defaults to the one above)
AWS_S3_ENDPOINT_URL=                  # e.g. https://sgp1.digitaloceanspaces.com (blank for AWS)
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FILE_URL_TTL_SECONDS=600              # lifetime of signed document links

# --- Monitoring -------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Domain settings ----------------------------------------------------------------
PRIVACY_EXPORT_TTL_HOURS=72
PAYOUT_PROVIDERS=bank_file            # + esewa,khalti,connectips once contracts exist
PAYOUT_WEBHOOK_SECRETS=               # esewa=...,khalti=...
THROTTLE_ANON=120/minute
THROTTLE_USER=600/minute
THROTTLE_OTP=30/hour
THROTTLE_PUBLIC=60/minute

# --- Security & platform (docs/SECURITY.md §9) ------------------------------------
STAFF_MFA_REQUIRED=true               # ops staff must enrol TOTP before using /ops
METRICS_TOKEN=                        # bearer token for /api/v1/metrics (blank = endpoint 404s)
COMPOSE_PROFILES=                     # set to "clamav" to start the optional virus scanner
CLAMAV_HOST=                          # "clamav" when the profile is enabled; blank = scanning skipped
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false                 # true = reject uploads while the scanner is down
IDEMPOTENCY_TTL_HOURS=24
OTP_MAX_PER_HOUR=5                    # OTP requests per phone per hour
OTP_RESEND_COOLDOWN_SECONDS=30        # server-side resend cooldown per phone (0 = off)
FEATURE_FLAG_CACHE_SECONDS=30         # /ops/flags changes take effect within this many seconds
KYC_FOUR_EYES=false                   # true = a second verifier must confirm KYC (or use flag kyc_four_eyes)
PAYOUT_WEBHOOK_MAX_SKEW_SECONDS=300   # X-Timestamp tolerance on payout webhooks
PAYOUT_WEBHOOK_REPLAY_TTL_SECONDS=86400

# --- Billing, VAT & telemetry -------------------------------------------------------
VAT_RATE=13                           # percent
INVOICE_DUE_DAYS=15
BILLING_SELLER_NAME=KaamSathi Pvt. Ltd.
BILLING_SELLER_ADDRESS=Kathmandu, Nepal
BILLING_SELLER_PAN=                   # printed on tax invoices; required for IRD CBMS
IRD_CBMS_ENABLED=false                # keep false until IRD e-billing registration
IRD_CBMS_URL=
IRD_CBMS_USERNAME=
IRD_CBMS_PASSWORD=
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=400
TELEMETRY_THROTTLE_RATE=60/minute

# --- Backups ------------------------------------------------------------------------
BACKUP_HOUR=2                         # local time (Asia/Kathmandu)
BACKUP_RETENTION_DAYS=14              # local copies in the `backups` volume
BACKUP_MEDIA=true                     # also tar the media volume (local storage only)
BACKUP_PASSPHRASE=                    # strongly recommended: encrypts dumps (they contain ID photos)
BACKUP_S3_BUCKET=                     # optional off-site copy (any S3-compatible service)
BACKUP_S3_PREFIX=kaamsathi
BACKUP_S3_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
